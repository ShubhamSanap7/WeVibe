# ==============================================================================
# WeVibe Discord Bot - Environment Configuration
# ==============================================================================

# Your Discord Bot Token (From Discord Developer Portal -> Bot -> Token)
# Ensure Message Content Intent, Server Members Intent, and Presence Intent are enabled!
DISCORD_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
# Required for instant slash command synchronization
GUILD_ID=123456789012345678

# Comma-separated Discord user IDs allowed to manage certified-only commands
CERTIFIED_USER_IDS=123456789012345678,987654321098765432

# ------------------------------------------------------------------------------
# Channel IDs (Right-click channel in Discord -> Copy Channel ID)
# ------------------------------------------------------------------------------
# 1) News Channels
CHANNEL_BREAKING=123456789012345678
CHANNEL_RESEARCH=123456789012345678
CHANNEL_AI_NEWS=123456789012345678
CHANNEL_NEWS=123456789012345678

# 2) Interactive Feature Channels
CHANNEL_POLLS=123456789012345678
CHANNEL_STORY=123456789012345678

# Optional role ID to ping when a poll is posted; leave empty to disable
POLL_PING_ROLE_ID=

# Optional role ID to ping when a story starts or ends; leave empty to disable
STORY_PING_ROLE_ID=

# ------------------------------------------------------------------------------
# Optional Customizations
# ------------------------------------------------------------------------------
# UTC Hour (0-23) to automatically post the daily poll (Default: 14:00 UTC)
POLL_POST_HOUR_UTC=14

# Database location relative to project root or absolute path
DATABASE_PATH=data/wevibe.db
